# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# Application
# DEBUG=false
# ENVIRONMENT=production

# Set to false to hide /docs and /redoc in production
# DOCS_ENABLED=true

# Comma-separated list of allowed CORS origins (leave unset = no CORS headers)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Optional — health check tuning
# Seconds to wait on the Supabase ping before reporting unhealthy
# HEALTH_CHECK_TIMEOUT=3.0
# Table to read 1 row from during /health, to exercise the real Postgres path
# SUPABASE_HEALTH_TABLE=domains

# Optional — JWT verification
# How long to cache Supabase's public signing keys
# JWKS_CACHE_TTL=600
# Floor between key-rotation refetches (throttles forged-kid requests)
# JWKS_MIN_REFETCH_SECONDS=60

# Optional — brute-force limits, per (client IP, email)
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_SECONDS=300
# SIGNUP_MAX_ATTEMPTS=5
# SIGNUP_WINDOW_SECONDS=3600
