# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Supabase URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Key (Anon key is publishable, Service key is SENSITIVE)
SUPABASE_KEY=your-anon-or-service-key


# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Application
# DEBUG=false
# ENVIRONMENT=production

# Comma-separated list of allowed CORS origins (leave unset = no CORS headers)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ── Cron job ──────────────────────────────────────────────────────────────────
# [SENSITIVE] Service-role key from Supabase Dashboard → Settings → API → service_role
# ONLY used by the daily WHOIS cron — never exposed to users.
# SUPABASE_SERVICE_KEY=your-service-role-key

# [SENSITIVE] Random secret shared with Vercel so only it can call /cron/refresh-whois.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Set the same value in: Vercel Dashboard → Project → Settings → Environment Variables → CRON_SECRET
# CRON_SECRET=your-random-secret-here

# Seconds to wait between WHOIS lookups in the cron (default 2.0)
# WHOIS_BATCH_DELAY=2.0

# ── Health check tuning ───────────────────────────────────────────────────────
# Seconds to wait on the Supabase ping before reporting unhealthy
# HEALTH_CHECK_TIMEOUT=3.0
# Table to read 1 row from during /health, to exercise the real Postgres path
# SUPABASE_HEALTH_TABLE=domain_whois

# ── JWT verification ──────────────────────────────────────────────────────────
# How long to cache Supabase's public signing keys
# JWKS_CACHE_TTL=600
# Floor between key-rotation refetches (throttles forged-kid requests)
# JWKS_MIN_REFETCH_SECONDS=60

# ── Rate Limits ───────────────────────────────────────────────────────────────
# Brute-force limits, per (client IP, email)
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_SECONDS=300
# SIGNUP_MAX_ATTEMPTS=5
# SIGNUP_WINDOW_SECONDS=3600
